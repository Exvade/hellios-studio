<IfModule mod_rewrite.c>
    Options +SymLinksIfOwnerMatch -Indexes
    RewriteEngine On

    # 1. Blokir akses langsung ke file sensitif (.env, .git, .json, .lock, dll)
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]

    # 2. Redirect request publik ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>

# Proteksi ganda untuk file berawalan titik
<FilesMatch "^\.">
    Require all denied
</FilesMatch>